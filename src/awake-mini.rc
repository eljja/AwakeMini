#include <windows.h>
#pragma code_page(65001)
1 ICON "active.ico"
2 ICON "paused.ico"
3 ICON "attention.ico"
1 RT_MANIFEST "awake-mini.manifest"
1 VERSIONINFO
FILEVERSION 1,3,3,1
PRODUCTVERSION 1,3,3,1
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Awake Mini - Sleep, display and idle input control"
      VALUE "FileVersion", "1.3.3-winb1"
      VALUE "ProductName", "Awake Mini"
      VALUE "ProductVersion", "1.3.3-winb1"
      VALUE "OriginalFilename", "AwakeMini.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1000 DIALOGEX 0, 0, 206, 133
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Awake Mini 설정"
FONT 9, "Malgun Gothic"
BEGIN
    CONTROL "절전 방지 · 무기한 유지", 1001, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 4, 128, 12
    PUSHBUTTON "검은화면", 1012, 138, 2, 62, 14
    CONTROL "화면 켜기 유지", 1002, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 17, 184, 12
    CONTROL "화면보호기 방지 · 마우스 미세 이동", 1003, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 30, 194, 12
    LTEXT "마우스 이동 전 대기 시간", -1, 16, 46, 122, 11
    EDITTEXT 1004, 144, 43, 34, 15, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    LTEXT "분", -1, 182, 46, 18, 11
    CONTROL "업데이트 일시중지 연장 (시험)", 1008, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 61, 128, 12
    PUSHBUTTON "업데이트 설정", 1010, 138, 59, 62, 16
    LTEXT "OFF", 1009, 16, 77, 184, 20
    CONTROL "전체 일시정지", 1005, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 98, 90, 12
    CONTROL "Windows 시작 시 실행", 1011, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 98, 100, 12
    PUSHBUTTON "프로그램 종료", 1007, 6, 112, 62, 17
    DEFPUSHBUTTON "적용", IDOK, 72, 112, 62, 17
    PUSHBUTTON "최소화", IDCANCEL, 138, 112, 62, 17
END
